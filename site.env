# Contact channels shown on the site (contact page and footer).
#
# Edit a value and push to main; the site rebuilds itself. To change one without
# editing this file, add a GitHub repository variable with the same name
# (Settings -> Secrets and variables -> Actions -> Variables); it overrides the value here.
#
# Leave a value empty to hide that channel. A line marked "# placeholder" prints
# a reminder on every build until it is replaced. Nothing here is secret.

# WhatsApp number, international format. Opens a chat at https://wa.me/<number>.
WHATSAPP_NUMBER=+966533337712

# WeChat ID, shown with a copy button (WeChat has no web link that opens a chat).
WECHAT_ID=eam0g0q0bs   # placeholder: replace with the real WeChat ID
# Optional WeChat QR code: put the image in assets/images/contact/ and give its file name.
WECHAT_QR=

# LINE Official Account ID (the @handle). Opens https://line.me/R/ti/p/@handle.
LINE_ID=@703hgkfm   # placeholder: replace with the real LINE Official Account ID
